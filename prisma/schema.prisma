// Declara o gerador de cliente e a fonte de dados
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// --- MODELOS DE AUTENTICAÇÃO E UTILIZADOR ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  telefone      String?   // Campo personalizado
  whatsapp      String?   // Campo personalizado
  
  // Relações
  accounts      Account[]
  sessions      Session[]
  imoveis       Imovel[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


// --- MODELOS DE LOCALIZAÇÃO (NOVA ESTRUTURA) ---

model Provincia {
  id         String      @id @default(cuid())
  nome       String      @unique
  municipios Municipio[]
}

model Municipio {
  id          String    @id @default(cuid())
  nome        String
  provincia   Provincia @relation(fields: [provinciaId], references: [id])
  provinciaId String
  bairros     Bairro[]
}

model Bairro {
  id          String    @id @default(cuid())
  nome        String
  municipio   Municipio @relation(fields: [municipioId], references: [id])
  municipioId String
  imoveis     Imovel[]
}


// --- MODELO PRINCIPAL: IMÓVEL (VERSÃO FINAL E COMPLETA) ---

model Imovel {
  id           String   @id @default(cuid())
  titulo       String
  tipo         String   // Ex: Apartamento, Vivenda
  tipo_anuncio String   // Ex: para_arrendar, para_venda
  preco        Float
  quartos      Int
  casas_banho  Int
  largura      Float?   // Opcional
  comprimento  Float?   // Opcional
  descricao    String   @db.Text
  comodidades  String[] // Array de strings, ex: ["Garagem", "Piscina"]
  image_urls   String[] // Array com os links das imagens do Cloudinary
  status       String   @default("Pendente") // Status para aprovação do admin
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relação com a nova estrutura de Localização
  bairro       Bairro   @relation(fields: [bairroId], references: [id])
  bairroId     String

  // Relação com o Autor (Anunciante)
  author       User     @relation(fields: [authorId], references: [id])
  authorId     String
}